# Managed by the keycloak role; a local edit is overwritten on the next converge.
# Run-time options only: the build-time ones are baked into lib/quarkus by 'kc.sh build'. The
# database password is not here. It reaches Keycloak through KCRAW_DB_PASSWORD in the service's
# environment file, because a value in this file is subject to ${...} expansion.
# sslmode=require: always TLS, never a silent plaintext fallback. It does not authenticate the
# server; verify-full needs the RDS CA bundle delivered as a declared artifact.
db-url=jdbc:postgresql://{{ keycloak_running.database.host }}:{{ keycloak_running.database.port }}/{{ keycloak_running.database.name }}?sslmode=require
db-username={{ keycloak_running.database.username }}
db-pool-max-size={{ keycloak_running.database.pool_max_size }}
hostname={{ keycloak_running.hostname }}
http-enabled=true
http-port={{ keycloak_running.http_port }}
http-management-port={{ keycloak_running.management_port }}
proxy-headers={{ keycloak_running.proxy_headers }}
