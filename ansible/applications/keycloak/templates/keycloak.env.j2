{#- systemd reads this file as root before it drops to the service account; KCRAW_ passes each
    secret to Keycloak verbatim. Inside double quotes systemd treats a backslash before any of
    the four characters it escapes -- double quote, backslash, backtick, dollar -- as that
    character, so exactly those four are escaped. -#}
{%- macro quoted(value) -%}
"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('`', '\\`') | replace('$', '\\$') }}"
{%- endmacro -%}
# Managed by the keycloak role; a local edit is overwritten on the next converge.
KCRAW_DB_PASSWORD={{ quoted(keycloak_running.database.password) }}
KC_BOOTSTRAP_ADMIN_USERNAME={{ quoted(keycloak_running.administrator.username) }}
KCRAW_BOOTSTRAP_ADMIN_PASSWORD={{ quoted(keycloak_running.administrator.password) }}
